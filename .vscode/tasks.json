    "version": "2.0.0",
    "tasks": [
        {
            "label": "start-server",
            "detail": "Deploy audio-player on device to test",
            "type": "shell",
            "command": "./test-on-device.sh",
            "presentation": {
                "reveal": "always",
                "panel": "dedicated",
                "clear": true
            }
        },
        {
            "label": "cargo-build",
            "detail": "Run cargo Build",
            "type": "shell",
            "command": "cargo nextest run && mkdir -p /tmp/music && touch /tmp/music/song1.mp3 && AUDIO_PLAYER_MOCK=1 MUSIC_DIR=/tmp/music cargo run",
            "presentation": {
                "reveal": "always",
                "panel": "dedicated",
                "clear": true
            }
        }
    ]
}
